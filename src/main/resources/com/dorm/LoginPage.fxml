<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dorm.ui.controller.LoginController">
    <children>
      <AnchorPane prefHeight="67.0" prefWidth="400.0" style="-fx-background-color: #6BAED6;">
         <children>
              <Label layoutX="14.0" layoutY="20.0" text="LOGIN PAGE" textFill="WHITE">
                  <font>
                      <Font name="System Bold" size="18.0" />
                  </font>
              </Label>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="200.0" prefWidth="200.0">
         <children>
      
                          <TextField fx:id="usernameInput" layoutX="41.0" layoutY="40.0" promptText="User Name" />
              <PasswordField fx:id="passwordInput" layoutX="41.0" layoutY="80.0" promptText="Password" />
      
                    <Button fx:id="loginButton" layoutX="41.0" layoutY="129.0" maxWidth="Infinity" onAction="#handleLogin" text="Login" />
      
                          <Label fx:id="statusLabel" textFill="RED" />
         </children>
      </AnchorPane>
    </children>
</VBox>
